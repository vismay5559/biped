  <inertial>
    <origin xyz="-0.02596578877638181 0.040055930981735204 -0.06312890393675653" rpy="0 0 0"/>
    <mass value="0.28302671867800727"/>
    <inertia ixx="0.000807" iyy="0.000697" izz="0.0002" ixy="1.4e-05" iyz="0.000225" ixz="-4.3e-05"/>
