    <mass value="0.20396927834762796"/>
    <inertia ixx="8.1e-05" iyy="6.1e-05" izz="7.1e-05" ixy="4e-06" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.05986 0.04025 0.0003" rpy="0 0 0"/>
