<link name="r_hip_link_1">
  <inertial>
    <origin xyz="0.02430149749802586 0.03928146808593818 3.680707215000177e-05" rpy="0 0 0"/>
    <mass value="0.20396927834762757"/>
    <inertia ixx="8.1e-05" iyy="6.1e-05" izz="7.1e-05" ixy="-4e-06" iyz="0.0" ixz="-0.0"/>
