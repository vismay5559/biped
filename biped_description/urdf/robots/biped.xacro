    <origin xyz="0.05986 0.04025 0.0003" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find biped_description)/meshes/l_hip_link_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

