<?xml version="1.0" ?>
<robot name="biped" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find biped_description)/urdf/robots/materials.xacro" />
<xacro:include filename="$(find biped_description)/urdf/robots/biped.ros2control" />
<xacro:include filename="$(find biped_description)/urdf/robots/biped.gazebo" />
<xacro:include filename="$(find biped_description)/urdf/control/biped_ros2_control.urdf.xacro"/>
<xacro:include filename="$(find biped_description)/urdf/control/gazebo_sim_ros2_control.urdf.xacro"/>

<link name="base_link">
  <inertial>
    <origin xyz="-0.030000000000000387 -0.057942318207656995 0.0017019536789480547" rpy="0 0 0"/>
    <mass value="0.44745204814551776"/>
    <inertia ixx="0.000206" iyy="0.000653" izz="0.000555" ixy="0.0" iyz="7e-06" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find biped_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find biped_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

