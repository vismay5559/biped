<joint name="l_abduction" type="revolute">
  <limit lower="-2.5" upper="2.5" effort="4.1" velocity="45.5"/>
  <origin xyz="-0.05986 -0.04025 -0.0003" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="l_hip_link_1"/>
  <axis xyz="0.0 1.0 0.0"/>
  <dynamics damping="0.01" friction="0.06"/>
</joint>

<joint name="l_hip_roll" type="revolute">
  <limit lower="-2.5" upper="2.5" effort="4.1" velocity="45.5"/>
  <origin xyz="-0.042 0.040277 4.4e-05" rpy="0 0 0"/>
  <parent link="l_hip_link_1"/>
  <child link="l_hip_roll__1"/>
  <axis xyz="-1.0 0.0 0.0"/>
  <dynamics damping="0.01" friction="0.06"/>
</joint>

<joint name="l_knee_roll" type="revolute">
  <limit lower="-2.5" upper="2.5" effort="4.1" velocity="45.5"/>
  <origin xyz="-0.047484 0.063923 -0.222186" rpy="0 0 0"/>
  <parent link="l_hip_roll__1"/>
  <child link="l_knee_link_1"/>
  <axis xyz="-1.0 0.0 0.0"/>
  <dynamics damping="0.01" friction="0.06"/>
</joint>


<joint name="r_abduction" type="revolute">
  <limit lower="-2.5" upper="2.5" effort="4.1" velocity="45.5"/>
  <origin xyz="-0.00014 -0.04025 -0.0003" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="r_hip_link_1"/>
  <axis xyz="0.0 1.0 0.0"/>
  <dynamics damping="0.01" friction="0.06"/>
</joint>

<joint name="r_hip_roll" type="revolute">
  <limit lower="-2.5" upper="2.5" effort="4.1" velocity="45.5"/>
  <origin xyz="0.042 0.040277 4.4e-05" rpy="0 0 0"/>
  <parent link="r_hip_link_1"/>
  <child link="r_hip_roll__1"/>
  <axis xyz="1.0 0.0 0.0"/>
  <dynamics damping="0.01" friction="0.06"/>
</joint>

<joint name="r_knee_roll" type="revolute">
  <limit lower="-2.5" upper="2.5" effort="4.1" velocity="45.5"/>
  <origin xyz="0.047484 0.063923 -0.222186" rpy="0 0 0"/>
  <parent link="r_hip_roll__1"/>
  <child link="r_knee_link_1"/>
  <axis xyz="1.0 0.0 0.0"/>
  <dynamics damping="0.01" friction="0.06"/>
</joint>


<gazebo reference="l_knee_link_1">
  <mu1>0.9</mu1>
  <mu2>0.9</mu2>
  
  <kp>100000.0</kp> 
  <kd>1.0</kd> 
  
  <minDepth>0.001</minDepth>  
  <maxVel>0.1</maxVel>        
</gazebo>

<gazebo reference="r_knee_link_1">
  <mu1>0.9</mu1>
  <mu2>0.9</mu2>
  <kp>100000.0</kp>
  <kd>1.0</kd>
  <minDepth>0.001</minDepth>
  <maxVel>0.1</maxVel>
</gazebo>

<gazebo reference="base_link">
  <sensor name="biped_imu" type="imu">
    <always_on>true</always_on>
    <update_rate>100</update_rate>
    <visualize>true</visualize>
    <topic>imu</topic>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system">
    </plugin>
  </sensor>
</gazebo>

</robot>