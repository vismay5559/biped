  </collision>
</link>

<link name="l_knee_link_1">
  <inertial>
    <origin xyz="-0.019576444185569586 -0.05041258328103008 -0.10359275990065434" rpy="0 0 0"/>
    <mass value="0.0412087002638959"/>
    <inertia ixx="0.000249" iyy="0.000199" izz="5.4e-05" ixy="-1e-06" iyz="-9.3e-05" ixz="-2e-06"/>
  </inertial>
  <visual>
    <origin xyz="0.149344 -0.09425 0.211384" rpy="0 0 0"/>
