<link name="r_knee_link_1">
  <inertial>
    <origin xyz="0.01957644594988535 -0.05041114422946669 -0.10359401216545042" rpy="0 0 0"/>
    <mass value="0.04120867834471891"/>
    <inertia ixx="0.000249" iyy="0.000199" izz="5.4e-05" ixy="1e-06" iyz="-9.3e-05" ixz="2e-06"/>
