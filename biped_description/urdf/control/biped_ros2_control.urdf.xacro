<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Hardware mode: ESP32 via Masterboard -->
  <xacro:if value="$(arg use_sim)">
    <!-- Simulation with Gazebo -->
    <ros2_control name="BipedSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <joint name="l_abduction">
        <command_interface name="effort">
        <param name="min">-1.3</param>
        <param name="max">1.3</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="l_hip_roll">
        <command_interface name="effort">
        <param name="min">-1.3</param>
        <param name="max">1.3</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="l_knee_roll">
        <command_interface name="effort">
        <param name="min">-1.3</param>
        <param name="max">1.3</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="r_abduction">
        <command_interface name="effort">
        <param name="min">-1.3</param>
        <param name="max">1.3</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="r_hip_roll">
        <command_interface name="effort">
        <param name="min">-1.3</param>
        <param name="max">1.3</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="r_knee_roll">
        <command_interface name="effort">
        <param name="min">-1.3</param>
        <param name="max">1.3</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>


    </ros2_control>
  </xacro:if>
  
  <xacro:unless value="$(arg use_sim)">
    <!-- Real Hardware: ESP32 with Torque Control -->
    <ros2_control name="BipedSystem" type="system">
    <hardware>
    <plugin>biped_hardware_interface/ESP32HardwareInterface</plugin>
    <param name="masterboard_port">192.168.4.1</param> 
    </hardware>

      <joint name="l_abduction">
        <command_interface name="effort">
          <param name="min">-1.3</param>
          <param name="max">1.3</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="l_hip_roll">
        <command_interface name="effort">
          <param name="min">-1.3</param>
          <param name="max">1.3</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="l_knee_roll">
        <command_interface name="effort">
          <param name="min">-1.3</param>
          <param name="max">1.3</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="r_abduction">
        <command_interface name="effort">
          <param name="min">-1.3</param>
          <param name="max">1.3</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="r_hip_roll">
        <command_interface name="effort">
          <param name="min">-1.3</param>
          <param name="max">1.3</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="r_knee_roll">
        <command_interface name="effort">
          <param name="min">-1.3</param>
          <param name="max">1.3</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

    </ros2_control>
  </xacro:unless>
  
  <gazebo reference="l_abduction"><provideFeedback>true</provideFeedback></gazebo>
  <gazebo reference="l_hip_roll"><provideFeedback>true</provideFeedback></gazebo>
  <gazebo reference="l_knee_roll"><provideFeedback>true</provideFeedback></gazebo>
  
  
  <gazebo reference="r_abduction"><provideFeedback>true</provideFeedback></gazebo>
  <gazebo reference="r_hip_roll"><provideFeedback>true</provideFeedback></gazebo>
  <gazebo reference="r_knee_roll"><provideFeedback>true</provideFeedback></gazebo>

</robot>