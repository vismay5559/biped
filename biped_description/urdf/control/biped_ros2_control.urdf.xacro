<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================================= -->
  <!-- ros2_control hardware specification for BIPED -->
  <!-- ========================================================= -->

  <ros2_control name="BipedSystem" type="system">

    <!-- Gazebo simulated hardware -->
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- ================= LEFT LEG (ACTUATED) ================= -->

    <joint name="l_abduction">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="l_hip_roll">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="l_knee_roll">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- ================= RIGHT LEG (ACTUATED) ================= -->

    <joint name="r_abduction">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="r_hip_roll">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="r_knee_roll">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- ================= PASSIVE JOINTS ================= -->
    <!-- Feet are intentionally NOT listed -->
    <!-- left_foot_roll, right_foot_roll -->
    <!-- Passive joints are handled kinematically -->

  </ros2_control>

</robot>
