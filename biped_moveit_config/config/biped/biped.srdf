<?xml version="1.0" encoding="UTF-8"?>
<robot name="biped">

  <virtual_joint name="virtual_joint" type="floating" parent_frame="world" child_link="base_link"/>

  <group name="biped">
    <joint name="l_abduction"/>
    <joint name="l_hip_roll"/>
    <joint name="l_knee_roll"/>
    <joint name="r_abduction"/>
    <joint name="r_hip_roll"/>
    <joint name="r_knee_roll"/>
  </group>

  <group name="left_leg">
    <joint name="l_abduction"/>
    <joint name="l_hip_roll"/>
    <joint name="l_knee_roll"/>
  </group>

  <group name="right_leg">
    <joint name="r_abduction"/>
    <joint name="r_hip_roll"/>
    <joint name="r_knee_roll"/>
  </group>

  <end_effector name="left_foot"
                parent_link="l_knee_link_1"
                group="left_leg"/>

  <end_effector name="right_foot"
                parent_link="r_knee_link_1"
                group="right_leg"/>

  <disable_collisions link1="base_link" link2="l_hip_link_1" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="r_hip_link_1" reason="Adjacent"/>

  <disable_collisions link1="base_link" link2="l_hip_roll__1" reason="Never"/>
  <disable_collisions link1="base_link" link2="l_knee_link_1" reason="Never"/>
  <disable_collisions link1="base_link" link2="r_hip_roll__1" reason="Never"/>
  <disable_collisions link1="base_link" link2="r_knee_link_1" reason="Never"/>

  <disable_collisions link1="l_hip_link_1" link2="l_hip_roll__1" reason="Adjacent"/>
  <disable_collisions link1="l_hip_roll__1" link2="l_knee_link_1" reason="Adjacent"/>

  <disable_collisions link1="r_hip_link_1" link2="r_hip_roll__1" reason="Adjacent"/>
  <disable_collisions link1="r_hip_roll__1" link2="r_knee_link_1" reason="Adjacent"/>

  <disable_collisions link1="l_hip_link_1" link2="r_hip_link_1" reason="Never"/>
  <disable_collisions link1="l_hip_roll__1" link2="r_hip_roll__1" reason="Never"/>
  <disable_collisions link1="l_knee_link_1" link2="r_knee_link_1" reason="Never"/>

  <group_state name="stand" group="biped">
    <joint name="l_abduction" value="0.0"/>
    <joint name="l_hip_roll" value="0.0"/>
    <joint name="l_knee_roll" value="0.0"/>
    <joint name="r_abduction" value="0.0"/>
    <joint name="r_hip_roll" value="0.0"/>
    <joint name="r_knee_roll" value="0.0"/>
  </group_state>

  <group_state name="crouch" group="biped">
    <joint name="l_abduction" value="0.0"/>
    <joint name="l_hip_roll" value="0.3"/>
    <joint name="l_knee_roll" value="-0.6"/>
    <joint name="r_abduction" value="0.0"/>
    <joint name="r_hip_roll" value="0.3"/>
    <joint name="r_knee_roll" value="-0.6"/>
  </group_state>

</robot>